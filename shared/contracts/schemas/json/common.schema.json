{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayvo.app/schemas/common.schema.json",
  "title": "Wayvo Common Schemas",
  "description": "Unified API envelopes, errors, and correlation headers",
  "definitions": {
    "ApiError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      },
      "additionalProperties": false
    },
    "ApiResponse": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "data": {},
        "message": { "type": "string" },
        "error": { "$ref": "#/definitions/ApiError" }
      },
      "additionalProperties": false
    },
    "CorrelationContext": {
      "type": "object",
      "required": ["correlationId"],
      "properties": {
        "correlationId": { "type": "string" },
        "sourceService": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
