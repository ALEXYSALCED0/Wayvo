PORT=3005
NODE_ENV=development

# real = Stripe de verdad (claves de PRUEBA sk_test_...), mock = simulador local sin claves.
PAYMENTS_MODE=mock

# --- Solo con PAYMENTS_MODE=real. Las claves van SOLO aquí (.env está en .gitignore). ---
# Panel de Stripe (modo prueba) > Desarrolladores > Claves de API
STRIPE_SECRET_KEY=
# ID del precio mensual de USD 4.95 (price_...), creado en Stripe > Catálogo de productos
STRIPE_PRICE_ID=
# Secreto del webhook (whsec_...), de Stripe > Webhooks o de `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Tiempo máximo de espera por llamada a Stripe, en milisegundos
STRIPE_TIMEOUT_MS=10000

# --- Cuenta del usuario (auth-service): ahí se guarda el plan FREE / PREMIUM ---
# Vacío = cuenta simulada en memoria (solo desarrollo). En producción es obligatorio.
AUTH_SERVICE_URL=
# Token compartido con auth-service para las rutas internas (el mismo valor en los dos .env)
INTERNAL_SERVICE_TOKEN=
ACCOUNT_TIMEOUT_MS=5000

# Información del plan que muestra GET /api/v1/payments/plan (el cobro real lo define el precio de Stripe)
PLAN_PRICE_CENTS=495
PLAN_CURRENCY=usd
