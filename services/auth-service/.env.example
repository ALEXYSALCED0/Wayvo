PORT=3004
NODE_ENV=development
DATABASE_URL="postgresql://wayvo:wayvo@localhost:5436/auth_db?schema=public"

# Secreto con el que se firman los JWT. Debe ser EL MISMO en api-gateway.
# Generar uno largo y aleatorio (ver README). Si se deja vacío se usa uno de desarrollo.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
BCRYPT_ROUNDS=10

# Correos (separados por coma) que obtienen rol ADMIN al registrarse.
ADMIN_EMAILS=

# Token compartido con payment-service para las rutas internas (cambiar el plan de una cuenta).
# Debe ser EL MISMO valor en payment-service. Vacío = token de desarrollo (en producción es obligatorio).
INTERNAL_SERVICE_TOKEN=
