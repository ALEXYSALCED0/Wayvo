{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Wayvo API Gateway - Reverse Proxy, Centralized Error Handling and Facade Pattern",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
