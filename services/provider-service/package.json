{
  "name": "provider-service",
  "version": "0.1.0",
  "private": true,
  "description": "Wayvo Provider Service - Provider Catalog, External Adapters and Mock APIs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:prod": "prisma migrate deploy && node dist/infrastructure/persistence/seed/run-seed.js && node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx src/infrastructure/persistence/seed/run-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@wayvo/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.24.2 || ^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "~6.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
