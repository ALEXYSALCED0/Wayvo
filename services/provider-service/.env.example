PORT=3002
NODE_ENV=development
DATABASE_URL="postgresql://wayvo:wayvo@localhost:5434/provider_db?schema=public"

# Simulador de fallos del proveedor (modo inicial): normal | unavailable | slow | error
# Se cambia en caliente con: GET /api/v1/mock/simulate-failure?mode=unavailable
SIMULATE_FAILURE_MODE=normal
# Poner "false" para no montar el simulador (en NODE_ENV=production nunca se monta)
ENABLE_MOCK_API=true

# APIs externas de proveedores
EXTERNAL_PROVIDERS_MODE=mock
MOCK_API_BASE_URL=http://localhost:3002/api/v1/mock/external

SERPAPI_API_KEY=
SERPAPI_CURRENCY=COP
HOTELS_API_KEY=
HOTELS_API_LIMIT=20
EXTERNAL_API_TIMEOUT_MS=10000
