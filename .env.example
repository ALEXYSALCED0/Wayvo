# ==========================================
# PUERTOS DE SERVICIOS
# ==========================================
GATEWAY_PORT=3000
BOOKING_SERVICE_PORT=3001
PROVIDER_SERVICE_PORT=3002
TRIP_SERVICE_PORT=3003
AUTH_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
AI_SERVICE_PORT=8000
CLIENT_WEB_PORT=19006
CLIENT_METRO_PORT=8081

# ==========================================
# BASES DE DATOS POSTGRESQL (DOCKER HOST PORTS)
# ==========================================
BOOKING_DB_PORT=5433
PROVIDER_DB_PORT=5434
TRIP_DB_PORT=5435
AUTH_DB_PORT=5436
PAYMENT_DB_PORT=5437

POSTGRES_USER=wayvo
POSTGRES_PASSWORD=wayvo

# ==========================================
# CADENAS DE CONEXIÓN LOCALES
# ==========================================
BOOKING_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5433/booking_db?schema=public"
PROVIDER_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5434/provider_db?schema=public"
TRIP_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5435/trip_db?schema=public"
AUTH_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5436/auth_db?schema=public"
PAYMENT_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5437/payment_db?schema=public"

# ==========================================
# URLS DE MICROSERVICIOS (GATEWAY / CLIENT)
# ==========================================
BOOKING_SERVICE_URL="http://localhost:3001"
PROVIDER_SERVICE_URL="http://localhost:3002"
TRIP_SERVICE_URL="http://localhost:3003"
AI_SERVICE_URL="http://localhost:8000"
AUTH_SERVICE_URL="http://localhost:3004"
PAYMENT_SERVICE_URL="http://localhost:3005"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ==========================================
# AI ENGINE (LANGGRAPH / LLM)
# ==========================================
# Gemini (Google AI Studio) es el LLM principal; Groq y OpenRouter son respaldo opcional.
GOOGLE_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# ==========================================
# APIS EXTERNAS DE PROVEEDORES (provider-service y ai-recommendation)
# Nunca escribir las claves reales aquí ni en docker-compose.yml: van en .env (ignorado por git).
# ==========================================
# real = SerpAPI + hotels-api.com (requiere las dos claves de abajo; sin ellas provider-service no arranca)
# mock = simulador local, no necesita claves
EXTERNAL_PROVIDERS_MODE="real"
# Recarga automática de cupo en provider-service (modo demo). Poner "false" para
# ver el comportamiento real: sin cupo -> rechazo -> la Saga compensa.
DEMO_AUTO_REFILL_CAPACITY="true"
SERPAPI_API_KEY=""
SERPAPI_CURRENCY="COP"
HOTELS_API_KEY=""

# ==========================================
# AUTENTICACIÓN (auth-service + api-gateway)
# ==========================================
# Secreto con el que auth-service firma los JWT y el api-gateway los verifica.
# Debe ser largo y aleatorio. Generarlo en PowerShell con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Si se deja vacío se usa un secreto de desarrollo (solo para pruebas locales).
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS="28800"
# Correos (separados por coma) que obtienen rol ADMIN al registrarse.
ADMIN_EMAILS=""

# ==========================================
# PAGOS: SUSCRIPCIÓN PREMIUM (payment-service + Stripe)
# ==========================================
# mock = simulador local, no cobra nada y no necesita claves. real = Stripe en modo PRUEBA.
PAYMENTS_MODE="mock"
# Solo con PAYMENTS_MODE=real (claves de PRUEBA sk_test_...; este archivo está ignorado por git):
# Clave PUBLICABLE (pk_test_...): la usa el navegador para mostrar el formulario de pago de Stripe.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Token compartido por auth-service y payment-service para las rutas internas (cambiar el plan de una cuenta).
# Largo y aleatorio. Vacío = token de desarrollo (en producción es obligatorio).
INTERNAL_SERVICE_TOKEN=""

# Cuenta FREE: planes de IA por mes calendario (PREMIUM: sin límite) y zona horaria con la que se cuenta el mes.
FREE_AI_PLANS_PER_MONTH="5"
USAGE_TIMEZONE="America/Bogota"
