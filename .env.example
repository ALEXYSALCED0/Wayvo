# ==========================================
# PUERTOS DE SERVICIOS
# ==========================================
GATEWAY_PORT=3000
BOOKING_SERVICE_PORT=3001
PROVIDER_SERVICE_PORT=3002
TRIP_SERVICE_PORT=3003
AI_SERVICE_PORT=8000
CLIENT_WEB_PORT=19006
CLIENT_METRO_PORT=8081

# ==========================================
# BASES DE DATOS POSTGRESQL (DOCKER HOST PORTS)
# ==========================================
BOOKING_DB_PORT=5433
PROVIDER_DB_PORT=5434
TRIP_DB_PORT=5435

POSTGRES_USER=wayvo
POSTGRES_PASSWORD=wayvo

# ==========================================
# CADENAS DE CONEXIÓN LOCALES
# ==========================================
BOOKING_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5433/booking_db?schema=public"
PROVIDER_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5434/provider_db?schema=public"
TRIP_DATABASE_URL="postgresql://wayvo:wayvo@localhost:5435/trip_db?schema=public"

# ==========================================
# URLS DE MICROSERVICIOS (GATEWAY / CLIENT)
# ==========================================
BOOKING_SERVICE_URL="http://localhost:3001"
PROVIDER_SERVICE_URL="http://localhost:3002"
TRIP_SERVICE_URL="http://localhost:3003"
AI_SERVICE_URL="http://localhost:8000"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ==========================================
# AI ENGINE (LANGGRAPH / LLM)
# ==========================================
# Gemini (Google AI Studio) es el LLM principal; Groq y OpenRouter son respaldo opcional.
GOOGLE_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# ==========================================
# APIS EXTERNAS DE PROVEEDORES (provider-service y ai-recommendation)
# Nunca escribir las claves reales aquí ni en docker-compose.yml: van en .env (ignorado por git).
# ==========================================
# real = SerpAPI + hotels-api.com (requiere las dos claves de abajo; sin ellas provider-service no arranca)
# mock = simulador local, no necesita claves
EXTERNAL_PROVIDERS_MODE="real"
SERPAPI_API_KEY=""
SERPAPI_CURRENCY="COP"
HOTELS_API_KEY=""
